# ==========================================
# CFMeeting VPS Server Configuration
# ==========================================

# Server Port and Host
PORT=3000
HOST=0.0.0.0
APP_NAME=CFMeeting

# Mode: "false" = Use your own Cloudflare RealtimeKit credentials; "true" = Public demo proxy
DEMO_PROXY=false

# Cloudflare RealtimeKit API Credentials
CF_ACCOUNT_ID=
RTK_APP_ID=
CF_API_TOKEN=

# Presets Configuration
RTK_HOST_PRESET=cfmeeting_host
RTK_PARTICIPANT_PRESET=cfmeeting_participant
RTK_WEBINAR_HOST_PRESET=cfmeeting_webinar_host
RTK_WEBINAR_PARTICIPANT_PRESET=cfmeeting_webinar_participant

# Meeting Creation Access Code (Leave blank for public/open meeting creation)
CREATE_ACCESS_CODE=Zinmeet456

# Security HMAC Secret for Host Keys (Replace with a random secret)
HOST_KEY_SECRET=cfmeeting_vps_secret_key_change_me_2026

# Allowed Origins for CORS (* or specific domain https://meet.yourdomain.com)
ALLOWED_ORIGINS=*

# Session Timeout (Seconds after last participant leaves)
SESSION_KEEP_ALIVE_SECS=60

# ==========================================
# VPS Local Recording Storage Settings
# ==========================================
ALLOW_RECORDING=true
AUTO_DOWNLOAD_RECORDINGS=true
RECORDINGS_DIR=./recordings
SYNC_INTERVAL_SECS=30

# Static Web Directory
STATIC_DIR=../web/dist

# (For Caddy / Docker Reverse Proxy)
DOMAIN=meet.yourdomain.com
